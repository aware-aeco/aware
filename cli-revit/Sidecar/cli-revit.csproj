<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AwareRevit.Sidecar</RootNamespace>
    <AssemblyName>aware-revit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.33.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- BakeSceneRules.cs is compiled into this assembly (so the unit tests
       exercise it directly) AND embedded as source, because BakeSceneScript
       splices the same text into the Roslyn script that runs inside Revit.
       One text, two compilations — the rules the tests pin are the rules that
       mutate the model. -->
  <ItemGroup>
    <EmbeddedResource Include="BakeSceneRules.cs" LogicalName="BakeSceneRules.cs" />
  </ItemGroup>

  <!-- FailurePreprocessor.cs is embedded the same way, but NOT compiled here:
       it touches Autodesk.Revit.DB types, and this sidecar is deliberately
       Revit-version-neutral (it references no Revit assembly — that is why the
       bake runs as a script in the first place). The add-in compiles the same
       file via a link, so `exec` and `bake-scene` share one text. -->
  <ItemGroup>
    <Compile Remove="FailurePreprocessor.cs" />
    <EmbeddedResource Include="FailurePreprocessor.cs" LogicalName="FailurePreprocessor.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AwareRevit.Tests" />
  </ItemGroup>
</Project>

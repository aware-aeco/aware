<Project Sdk="Microsoft.NET.Sdk">

  <!--
    aware-roslyn — the SOURCE half of the #180 Reader/Recipe split. A non-AOT (JIT)
    sidecar that reads C# *source* via Roslyn and emits the SAME AwareReader IR +
    GeneratedAgent as the compiled-DLL path, so source and compiled inputs (and the Tekla
    recipe) share one synthesizer. Roslyn cannot be hosted in the NativeAOT sidecar, so it
    lives here and is invoked out-of-process by the Rust CLI exactly like aware-sidecar
    (stdin/stdout JSON).

    Published self-contained single-file per OS (see release.yml) so it needs no .NET
    runtime on the user's machine, matching aware-sidecar's "just a binary" deployment.

    The bare-.cs path uses Microsoft.CodeAnalysis.CSharp only: it compiles .cs files,
    directories, or globs with framework references plus any caller-supplied reference-dir
    DLLs. Pointing a reference dir at an SDK's bin (e.g. a Tekla install) resolves base types
    and attributes, so the recipe fires on source.

    The .csproj/.sln path (#185) adds Microsoft.CodeAnalysis.Workspaces.MSBuild +
    Microsoft.Build.Locator. The Microsoft.Build.* packages are pinned to a NON-vulnerable
    version (17.14.28 — clears CVE-2025-26646/NU1903 + CVE-2025-55247) with
    ExcludeAssets=runtime, so MSBuildLocator binds the host .NET SDK's MSBuild at run time and
    nothing vulnerable ships. That path therefore requires the .NET SDK on the user's machine
    (the bare-.cs path does not).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AwareRoslyn</RootNamespace>
    <AssemblyName>aware-roslyn</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <!-- Keep the unit-test sources out of the exe build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\cli-reader\AwareReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!--
    #185 — project/solution graph loading. MSBuildWorkspace pulls the Microsoft.Build.* chain,
    whose default-resolved versions ([17.7.2,)) carry open NuGet advisories (NU1903 /
    CVE-2025-26646; CVE-2025-55247) that the audit promotes to build errors. Pin all four to
    17.14.28 (the lowest version clearing BOTH) with ExcludeAssets=runtime: the version pin is
    what satisfies the audit; ExcludeAssets keeps the package's runtime assemblies out of our
    output so Microsoft.Build.Locator binds the host SDK's MSBuild at run time. (ExcludeAssets
    alone does NOT silence the audit — it flags the resolved version regardless of assets.)
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <!-- The C# WORKSPACE language services. Workspaces.MSBuild pulls only the language-agnostic
         Microsoft.CodeAnalysis.Workspaces; without this, MSBuildWorkspace's MEF host has no C#
         provider and OpenProject fails with "language 'C#' is not supported". -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <!--
      The Microsoft.Build.Tasks.Core chain pins System.Security.Cryptography.Xml to the 9.0.0
      line, which carries its own advisories (GHSA-37gx-xxp4-5rgx / CVE-2026-33116,
      GHSA-w3x6-4m5h-cxqf) and is NOT framework-pruned on net10 (it's an older-than-framework
      explicit version). Pin it up to a patched 9.0.x so the audit clears.

      This pin is a moving target: it is the audit floor, so a newly-published advisory against
      whatever is pinned here fails `dotnet restore` — and therefore the RELEASE build, since
      the audit is promoted to an error. 9.0.15 was cleared this way when GHSA-23rf-6693-g89p,
      GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f and GHSA-mmjf-rqrv-855v
      landed against `>= 9.0.0, <= 9.0.17`; 9.0.18 is the first patched 9.0.x. When this recurs,
      check the advisory's `first_patched_version` and bump to it.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="aware-roslyn.Tests" />
  </ItemGroup>

</Project>

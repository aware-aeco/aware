{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aware-aeco.github.io/schemas/model-source-capture-v1.schema.json",
  "title": "AWARE immutable model source capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "namespaces"],
  "properties": {
    "schemaVersion": { "const": "aware.model-source-capture/v1" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespaceId", "files"],
        "properties": {
          "namespaceId": { "$ref": "#/$defs/id" },
          "files": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "bytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!\\.{1,2}$)[A-Za-z0-9._-]{1,127}[A-Za-z0-9_-]$|^[A-Za-z0-9_-]$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "aware-portable-relative-path-v1",
      "$comment": "The custom format additionally requires NFC text and limits every segment and the complete path by UTF-8 byte length.",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$))(?!.*(?:^|/)[^/]{256})[^/\\\\:\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:\\u0000-\\u001f\\u007f]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

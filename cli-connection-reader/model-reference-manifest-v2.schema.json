{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aware.aeco.dev/schemas/model-reference-manifest-v2.schema.json",
  "title": "AWARE model reference manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "artifactVersion", "formatId", "capabilityId",
    "providerPackageManifestSha256", "effectiveSourceSha256", "conversionRequestSha256",
    "completeness", "indexes", "objects"
  ],
  "properties": {
    "schemaVersion": { "const": "model-reference-manifest/v2" },
    "artifactVersion": { "const": "2" },
    "formatId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "capabilityId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "providerPackageManifestSha256": { "$ref": "#/$defs/sha256" },
    "effectiveSourceSha256": { "$ref": "#/$defs/sha256" },
    "conversionRequestSha256": { "$ref": "#/$defs/sha256" },
    "completeness": { "enum": ["complete", "degraded"] },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "entities", "properties", "relationships"],
      "properties": {
        "geometry": { "$ref": "#/$defs/receipt" },
        "entities": { "$ref": "#/$defs/receipt" },
        "properties": { "$ref": "#/$defs/receipt" },
        "relationships": { "$ref": "#/$defs/receipt" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 5,
      "maxItems": 1029,
      "items": { "$ref": "#/$defs/receipt" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "logicalKind", "ordinal", "mediaType", "bytes", "sha256", "itemCount"],
      "properties": {
        "logicalPath": { "type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$" },
        "logicalKind": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 255 },
        "mediaType": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "itemCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "bounds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "number" }
        },
        "idRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last"],
          "properties": {
            "first": { "type": "string", "minLength": 1 },
            "last": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
